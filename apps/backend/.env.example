NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://marketplace:change-me-in-production@localhost:5432/marketplace?schema=public"
JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-secret"
JWT_ACCESS_EXPIRES_IN=15m
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://marketplace:change-me-in-production@localhost:5672
INTERNAL_CALL_TIMEOUT_MS=5000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CATALOG_MAX=120
RATE_LIMIT_CATALOG_WINDOW_SECONDS=60
