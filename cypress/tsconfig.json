{
    "compilerOptions": {
        "target": "ES2019",
        "lib": [
            "ES2021",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "allowJs": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "cypress",
            "node"
        ]
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js"
    ]
}